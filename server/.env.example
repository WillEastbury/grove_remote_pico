# Google OAuth2 credentials — create at https://console.cloud.google.com/
# Authorised redirect URI to register: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Random secret used to sign JWTs and session cookies
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Static bearer token the Pico sends on every request.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
PICO_DEVICE_TOKEN=change-me-pico-token
